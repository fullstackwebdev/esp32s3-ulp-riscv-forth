/* lora_peer - an OUTSIDE RECEIVER for the Forth/ULP transmitter on the Heltec V3.
 *
 * Purpose: the LoRa objective says the frame must be established "by the radio AND by an outside receiver". The
 * radio side is done (TxDone from the chip's own GetIrqStatus, GetStatus 0x2222, FIFO round-trip). This firmware is
 * the second board: it listens on 868.0 MHz / SF9 / BW125 / CR4-5 and prints every frame it decodes, with the
 * radio's own RSSI and SNR - numbers this program never computes, only copies out of the chip.
 *
 * GUARDRAIL: the HP core drives SPI here, deliberately. The transmitter must prove the coprocessor owns every SPI
 * edge; an OBSERVER must not share the transmitter's failure modes, so this one uses the hardware SPI peripheral on
 * the same pads. Two different drivers answering the same question is what makes the answer evidence (docs/14 R17).
 * GUARDRAIL: 868.0 MHz, not 868.1. The Forth driver's SET_RF_FREQUENCY literal is 0x36419999 = 868 000 000 Hz
 * exactly; probe/lora used 868.1 MHz. At BW125 that 100 kHz offset is a fifth of the channel and costs frames, and a
 * receiver 100 kHz off would have "proven" a broken transmitter.
 * GUARDRAIL: `r` (RX), `t` (TX a framed reply) and `?' (status) are typed single characters on the console, so the
 * link can be exercised in both directions without reflashing anything.
 */
#include <stdio.h>
#include <string.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/spi_master.h"
#include "driver/gpio.h"
#include "esp_timer.h"

#define PIN_SCK    9
#define PIN_MOSI   10
#define PIN_MISO   11
#define PIN_NSS    8
#define PIN_RESET  12
#define PIN_BUSY   13
#define PIN_DIO1   14

#define OP_SET_STANDBY      0x80
#define OP_SET_RX           0x82
#define OP_SET_TX           0x83
#define OP_SET_SLEEP        0x84
#define OP_SET_RF_FREQ      0x86
#define OP_SET_PACKET_TYPE  0x8A
#define OP_SET_MOD_PARAMS   0x8B
#define OP_SET_PACKET_PARAMS 0x8C
#define OP_SET_TX_PARAMS    0x8E
#define OP_SET_BUFFER_BASE  0x8F
#define OP_SET_DIO_IRQ      0x08
#define OP_SET_DIO2_RFSW    0x9D
#define OP_SET_DIO3_TCXO    0x97
#define OP_SET_REG_MODE     0x96
#define OP_SET_PA_CONFIG    0x95
#define OP_CALIBRATE        0x89
#define OP_CALIBRATE_IMAGE  0x98
#define OP_WRITE_BUFFER     0x0E
#define OP_READ_BUFFER      0x1E
#define OP_GET_IRQ_STATUS   0x12
#define OP_CLEAR_IRQ_STATUS 0x02
#define OP_GET_STATUS       0xC0
#define OP_GET_RX_BUF_STATUS 0x13
#define OP_GET_PACKET_STATUS 0x14

#define IRQ_TX_DONE  0x0001
#define IRQ_RX_DONE  0x0002
#define IRQ_PREAMBLE 0x0004
#define IRQ_HEADER   0x0010
#define IRQ_CRC_ERR  0x0040
#define IRQ_TIMEOUT  0x0200

#define FREQ_HZ   868000000UL
#define FREQ_REG  ((uint32_t)(((uint64_t)FREQ_HZ << 25) / 32000000ULL))
#define SF        9
#define BW_125    0x04
#define CR_4_5    1
#define PREAMBLE  8

static spi_device_handle_t spi;

static void nss(int level) { gpio_set_level((gpio_num_t)PIN_NSS, level); }

static void wait_busy_low(void)
{
    /* GUARDRAIL: this is hal_wait_busy(), and it is not a sleep. While RBUSY is high the SX1262 ignores SPI
     * completely - a command issued there is lost with no answer and no error. Bounded, so a chip that never frees
     * the bus reports a named timeout instead of hanging the peer. */
    for (int i = 0; i < 2000; i++) {
        if (gpio_get_level((gpio_num_t)PIN_BUSY) == 0) return;
        esp_rom_delay_us(100);
    }
    printf("peer: BUSY never went low (200 ms) - the radio is not answering\n");
}

/* One SX1262 transaction: NSS low, opcode, then write `wn` bytes and/or read `rn` bytes. */
static void xfer(const uint8_t *w, size_t wn, uint8_t *r, size_t rn)
{
    wait_busy_low();
    nss(0);
    if (wn) {
        spi_transaction_t t = { .length = 8 * wn, .tx_buffer = w };
        spi_device_transmit(spi, &t);
    }
    if (rn) {
        /* Dummy 0x00 out while clocking the answer in, MSB first - the SX1262 shifts its reply on the same edges. */
        uint8_t dummy[64] = { 0 };
        spi_transaction_t t = { .length = 8 * rn, .tx_buffer = dummy, .rx_buffer = r };
        spi_device_transmit(spi, &t);
    }
    nss(1);
    esp_rom_delay_us(20);
}

static void cmd(const uint8_t *p, size_t n) { xfer(p, n, NULL, 0); }

static void read_regs(const uint8_t prefix[2], uint8_t *out, size_t n) { xfer(prefix, 2, out, n); }

static uint16_t get_irq(void)
{
    const uint8_t p[3] = { OP_GET_IRQ_STATUS, 0x00, 0x00 };
    uint8_t r[3] = { 0 };
    xfer(p, 1, r, 3);             /* opcode, then status byte + 2 payload bytes */
    return ((uint16_t)r[1] << 8) | r[2];
}

static void clear_irq(uint16_t mask)
{
    const uint8_t p[3] = { OP_CLEAR_IRQ_STATUS, (uint8_t)(mask >> 8), (uint8_t)mask };
    cmd(p, 3);
}

static uint8_t get_status(void)
{
    const uint8_t p[2] = { OP_GET_STATUS, 0x00 };
    uint8_t r[2] = { 0 };
    xfer(p, 1, r, 2);
    return r[1];
}

static void set_packet_params(uint8_t len)
{
    const uint8_t p[7] = { OP_SET_PACKET_PARAMS, (uint8_t)(PREAMBLE >> 8), (uint8_t)PREAMBLE,
                          0x00 /* explicit header */, len, 0x01 /* CRC on */, 0x00 };
    cmd(p, 7);
}

static void enter_rx(void)
{
    /* Continuous RX: timeout 0xFFFFFF means "stay listening", so the observer never misses a burst because its
     * window expired - the previous peer firmware used a fixed 120 ms window and would have called a good frame a
     * timeout merely by arriving late. */
    const uint8_t rx[4] = { OP_SET_RX, 0xFF, 0xFF, 0xFF };
    clear_irq(0xFFFF);
    set_packet_params(32);        /* max payload we accept; explicit header carries the real length */
    cmd(rx, 4);
}

static void radio_init(void)
{
    gpio_config_t io = { .pin_bit_mask = (1ULL << PIN_NSS) | (1ULL << PIN_RESET) | (1ULL << PIN_SCK) |
                                       (1ULL << PIN_MOSI),
                         .mode = GPIO_MODE_INPUT_OUTPUT };
    gpio_config(&io);
    gpio_config_t in = { .pin_bit_mask = (1ULL << PIN_MISO) | (1ULL << PIN_BUSY) | (1ULL << PIN_DIO1),
                         .mode = GPIO_MODE_INPUT };
    gpio_config(&in);

    spi_bus_config_t bus = { .mosi_io_num = PIN_MOSI, .miso_io_num = PIN_MISO, .sclk_io_num = PIN_SCK,
                             .quadwp_io_num = -1, .quadhd_io_num = -1, .max_transfer_sz = 320 };
    ESP_ERROR_CHECK(spi_bus_initialize(SPI2_HOST, &bus, SPI_DMA_DISABLED));
    spi_device_interface_config_t dev = { .clock_speed_hz = 2 * 1000 * 1000, .mode = 0,
                                          .spics_io_num = -1, .queue_size = 1 };
    ESP_ERROR_CHECK(spi_bus_add_device(SPI2_HOST, &dev, &spi));

    nss(1);
    gpio_set_level((gpio_num_t)PIN_RESET, 0);
    vTaskDelay(pdMS_TO_TICKS(2));
    gpio_set_level((gpio_num_t)PIN_RESET, 1);
    vTaskDelay(pdMS_TO_TICKS(10));

    printf("peer: GetStatus 0x%02X (chipmode %u) - a radio is answering on NSS/SCK/MOSI/MISO 8/9/10/11\n",
           get_status(), (unsigned)((get_status() >> 4) & 0x7));

    const uint8_t standby[2] = { OP_SET_STANDBY, 0x00 };
    cmd(standby, 2);
    const uint8_t regmode[2] = { OP_SET_REG_MODE, 0x01 };        /* DC-DC */
    cmd(regmode, 2);
    const uint8_t ptype[2] = { OP_SET_PACKET_TYPE, 0x01 };       /* LoRa */
    cmd(ptype, 2);
    const uint8_t freq[5] = { OP_SET_RF_FREQ, (uint8_t)(FREQ_REG >> 24), (uint8_t)(FREQ_REG >> 16),
                              (uint8_t)(FREQ_REG >> 8), (uint8_t)FREQ_REG };
    cmd(freq, 5);
    const uint8_t mod[5] = { OP_SET_MOD_PARAMS, SF, BW_125, CR_4_5, 0x00 };
    cmd(mod, 5);
    const uint8_t pa[5] = { OP_SET_PA_CONFIG, 0x02, 0x02, 0x00, 0x01 };
    cmd(pa, 5);
    const uint8_t txp[3] = { OP_SET_TX_PARAMS, 14, 0x04 };        /* 14 dBm, 200 us ramp */
    cmd(txp, 3);
    const uint8_t base[3] = { OP_SET_BUFFER_BASE, 0x00, 0x00 };
    cmd(base, 3);
    const uint8_t dio2[2] = { OP_SET_DIO2_RFSW, 0x01 };
    cmd(dio2, 2);
    const uint8_t dio3[4] = { OP_SET_DIO3_TCXO, 0x02, 0x00, 0x07 };  /* 1.8 V - the Heltec needs it, measured */
    cmd(dio3, 4);
    const uint8_t imgcal[3] = { OP_CALIBRATE_IMAGE, 0xD7, 0xDB };    /* 863-870 MHz band */
    cmd(imgcal, 3);
    const uint8_t irq[9] = { OP_SET_DIO_IRQ, 0x00, 0xFF, 0x00, 0xFF, 0x00, 0x00, 0x00, 0x00 };
    cmd(irq, 9);

    enter_rx();
    printf("peer: listening at %lu Hz SF%u BW125 CR4/5, CRC on, continuous RX\n", (unsigned long)FREQ_HZ, SF);
}

static void peer_tx(const char *text)
{
    uint8_t len = (uint8_t)strlen(text);
    if (len == 0 || len > 32) len = 0;
    const uint8_t standby[2] = { OP_SET_STANDBY, 0x00 };
    cmd(standby, 2);
    set_packet_params(len);
    uint8_t w[2 + 32] = { OP_WRITE_BUFFER, 0x00 };
    memcpy(&w[2], text, len);
    cmd(w, (size_t)(2 + len));
    clear_irq(0xFFFF);
    const uint8_t t[4] = { OP_SET_TX, 0x00, 0x00, 0x00 };
    cmd(t, 4);
    /* GUARDRAIL: wait on the chip's IRQ word, not on a sleep. A sleep can report success for a frame that never
     * started; IRQ_TX_DONE comes from the radio's own state machine. */
    uint16_t irq = 0;
    for (int i = 0; i < 400; i++) {
        irq = get_irq();
        if (irq & (IRQ_TX_DONE | IRQ_TIMEOUT)) break;
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    printf("peer: TX %u B \"%s\" -> %s (irq 0x%04X)\n", len, text,
           (irq & IRQ_TX_DONE) ? "TxDone" : "NO TxDone", irq);
    enter_rx();
}

void app_main(void)
{
    radio_init();
    printf("peer: commands: `r` re-enter RX, `t` send the test reply, anything else = status\n");
    uint16_t frames = 0;
    for (;;) {
        int c = fgetc(stdin);
        if (c == 'r') { enter_rx(); printf("peer: re-entered RX\n"); }
        else if (c == 't') { peer_tx("PONG-FROM-PEER"); }
        else if (c >= 0) { printf("peer: status 0x%02X irq 0x%04X frames %u\n", get_status(), get_irq(), frames); }

        uint16_t irq = get_irq();
        if (irq & IRQ_RX_DONE) {
            /* GetRxBufferStatus: payload length, then buffer offset. ReadBuffer: opcode, offset, dummy, then bytes. */
            const uint8_t rbs[2] = { OP_GET_RX_BUF_STATUS, 0x00 };
            uint8_t b[2] = { 0 };
            xfer(rbs, 1, b, 2);
            uint8_t len = b[1];
            const uint8_t rbs2[3] = { OP_GET_RX_BUF_STATUS, 0x00, 0x00 };
            uint8_t b2[3] = { 0 };
            xfer(rbs2, 1, b2, 3);
            uint8_t start = b2[2];

            const uint8_t pkt[2] = { OP_GET_PACKET_STATUS, 0x00 };
            uint8_t ps[4] = { 0 };
            xfer(pkt, 1, ps, 4);
            /* RSSI is -ps[1]/2 dBm, SNR is ps[2]/4 dB, both per the datasheet; reported as the chip encodes them. */
            int rssi_x2 = ps[2], snr_x4 = ps[3];

            uint8_t hdr[3] = { OP_READ_BUFFER, start, 0x00 };
            uint8_t payload[40] = { 0 };
            uint8_t n = len > sizeof payload ? (uint8_t)sizeof payload : len;
            xfer(hdr, 2, payload, n);
            clear_irq(0xFFFF);
            frames++;
            printf("RX %u B rssi -%d.%d dBm snr %d.%d dB : ", len, rssi_x2 / 2, (rssi_x2 % 2) * 5,
                   snr_x4 / 4, (snr_x4 < 0 ? -((-snr_x4) % 4) : snr_x4 % 4) * 25);
            for (uint8_t i = 0; i < n; i++) printf("%02X ", payload[i]);
            printf("| ");
            for (uint8_t i = 0; i < n; i++) putchar((payload[i] >= 32 && payload[i] < 127) ? payload[i] : '.');
            printf("\n");
        } else if (irq & IRQ_CRC_ERR) {
            clear_irq(0xFFFF);
            printf("RX CRC error (irq 0x%04X) - a frame was heard but did not decode\n", irq);
        } else if (irq & IRQ_TIMEOUT) {
            clear_irq(0xFFFF);
            enter_rx();
        }
        vTaskDelay(pdMS_TO_TICKS(5));
    }
}
