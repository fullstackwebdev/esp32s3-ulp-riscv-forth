+#endif
+#if P54_BINOPS >= 2
+    [1] = p54_op_SUB,
+#endif
+#if P54_BINOPS >= 3
+    [2] = p54_op_MUL,
+#endif
+#if P54_BINOPS >= 4
+    [5] = p54_op_AND,
+#endif
+#if P54_BINOPS >= 5
+    [6] = p54_op_OR,
+#endif
+#if P54_BINOPS >= 6
+    [7] = p54_op_XOR,
+#endif
+#if P54_BINOPS >= 7
+    [9] = p54_op_LSHIFT,
+#endif
+#if P54_BINOPS >= 8
+    [10] = p54_op_RSHIFT,
+#endif
+#if P54_BINOPS >= 9
+    [12] = p54_op_LT,
+#endif
+#if P54_BINOPS >= 10
+    [13] = p54_op_ULT,
+#endif
+#if P54_NSLOT > 3
+    [3] = p54_op_unreachable,   /* P_ADD + 3 is not a same-shape op */
+#endif
+#if P54_NSLOT > 4
