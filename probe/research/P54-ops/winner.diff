+ *
+ * GUARDRAIL: every slot is `P_<id> - P_ADD` and every one is _Static_assert'ed against the real
+ * enum. P54's saving is that ten 38-44 B case bodies become one body plus one 4-6 B leaf each; a
+ * table indexed one off from the enum would dispatch the WRONG arithmetic and no test would catch
+ * it until a number came out wrong (F-107's shape) — hence a compiler check per slot, not a comment.
+ * GUARDRAIL: an unconverted slot holds p54_op_unreachable, never 0. A null function pointer is a
+ * call to address 0, i.e. DOCOL — the machine would silently run a different primitive instead of
+ * reporting the hole, which is the one failure class this engine is not allowed to have.
+ */
+#ifndef P54_OPS_H
+#define P54_OPS_H
+
+typedef u32 (*p54_binop_t)(u32 a, u32 b);
+
+/* forged by the generator: expression is shared with the inline (-DP54_OPSW) mechanism */
+#if P54_BINOPS >= 1
+static u32 p54_op_ADD(u32 a, u32 b) { return (a + b); }
+#endif
+#if P54_BINOPS >= 2
+static u32 p54_op_SUB(u32 a, u32 b) { return (a - b); }
+#endif
+#if P54_BINOPS >= 3
+static u32 p54_op_MUL(u32 a, u32 b) { return (a * b); }
+#endif
+#if P54_BINOPS >= 4
+static u32 p54_op_AND(u32 a, u32 b) { return (a & b); }
+#endif
+#if P54_BINOPS >= 5
+static u32 p54_op_OR(u32 a, u32 b) { return (a | b); }
+#endif
+#if P54_BINOPS >= 6
+static u32 p54_op_XOR(u32 a, u32 b) { return (a ^ b); }
+#endif
+#if P54_BINOPS >= 7
+static u32 p54_op_LSHIFT(u32 a, u32 b) { return (a << (b & 31u)); }
+#endif
+#if P54_BINOPS >= 8
+static u32 p54_op_RSHIFT(u32 a, u32 b) { return (a >> (b & 31u)); }
+#endif
+#if P54_BINOPS >= 9
+static u32 p54_op_LT(u32 a, u32 b) { return (((i32)a < (i32)b) ? ~0u : 0u); }
+#endif
+#if P54_BINOPS >= 10
+static u32 p54_op_ULT(u32 a, u32 b) { return ((a < b) ? ~0u : 0u); }
+#endif
+
+/* reached only if a table slot and a case label ever disagree: stop BY NAME, do not jump to 0 */
+static u32 p54_op_unreachable(u32 a, u32 b) { (void)a; (void)b; pl_halt(0x54u); return 0u; }
+
+_Static_assert(P_ADD == P_ADD + 0, "P54 slot drift: ADD");
+_Static_assert(P_SUB == P_ADD + 1, "P54 slot drift: SUB");
+_Static_assert(P_MUL == P_ADD + 2, "P54 slot drift: MUL");
+_Static_assert(P_AND == P_ADD + 5, "P54 slot drift: AND");
+_Static_assert(P_OR == P_ADD + 6, "P54 slot drift: OR");
+_Static_assert(P_XOR == P_ADD + 7, "P54 slot drift: XOR");
+_Static_assert(P_LSHIFT == P_ADD + 9, "P54 slot drift: LSHIFT");
+_Static_assert(P_RSHIFT == P_ADD + 10, "P54 slot drift: RSHIFT");
+_Static_assert(P_LT == P_ADD + 12, "P54 slot drift: LT");
+_Static_assert(P_ULT == P_ADD + 13, "P54 slot drift: ULT");
