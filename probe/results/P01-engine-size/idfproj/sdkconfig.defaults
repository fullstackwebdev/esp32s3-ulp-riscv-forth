CONFIG_IDF_TARGET="esp32s3"
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
# 8176 B is the S3 maximum: the MEMSZ=4096 variant needs room for mem[] plus stacks in the region,
# and the region length is what makes the two MEMSZ builds comparable at the same reserve.
CONFIG_ULP_COPROC_RESERVE_MEM=8176
