+#endif
+#if P54_NSLOT > 8
+    [8] = p54_op_unreachable,   /* P_ADD + 8 is not a same-shape op */
+#endif
+#if P54_NSLOT > 11
+    [11] = p54_op_unreachable,   /* P_ADD + 11 is not a same-shape op */
