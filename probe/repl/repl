#!/usr/bin/env python3
"""repl — talk to the ULP Forth machine from a shell.

The HP core is a dumb byte pump (see probe/repl/main/repl_main.c), so this is a terminal, not a
protocol client: it puts the local tty in raw mode, forwards what you type, and prints what the ULP
sends back. No framing, no framing bugs, nothing to get out of sync.

    ./repl                     # interactive; Ctrl-] quits
    ./repl --port /dev/ttyACM1 # explicit port
    echo '2 3 + .' | ./repl -  # scripted: send stdin, print the answer, exit

GUARDRAIL: raw mode is not cosmetic. With local echo on, every character appears twice — once from
your terminal and once from the ULP, which echoes deliberately so that what you see is proof the
bytes arrived. The duplicate is the classic reason a working REPL "looks broken".
"""
import argparse
import os
import select
import sys
import termios
import time
import tty

DEFAULT_PORT = "/dev/ttyACM1"      # CH343 -> UART0; also the flashing and recovery port
BAUD = 115200
QUIT = 0x1D                        # Ctrl-] : the reserved console escape (06-repl.md §3)


def open_port(port):
    try:
        import serial
    except ImportError:
        sys.exit("repl: pyserial is not installed (python3 -m pip install pyserial)")
    try:
        # GUARDRAIL: timeout must be non-zero, or a silent ULP blocks the reader forever and the
        # tool looks hung instead of reporting "the board is not answering".
        return serial.Serial(port, BAUD, timeout=0.2)
    except Exception as e:
        sys.exit("repl: cannot open %s: %s" % (port, e))


def drain(ser, out, idle=0.35):
    """Print whatever arrives until the line goes quiet. Bounded, so a silent board cannot hang us."""
    last = time.time()
    while time.time() - last < idle:
        chunk = ser.read(256)
        if chunk:
            out.write(chunk.decode("utf-8", "replace"))
            out.flush()
            last = time.time()
        else:
            time.sleep(0.01)


def batch(ser, out):
    for line in sys.stdin:
        # GUARDRAIL: strip \r as well as \n. A CRLF file sends \r then \n; the ULP treats each as
        # end-of-line, so a "double ok" per line is the CRLF leaking through, not a Forth bug.
        line = line.rstrip("\r\n")
        if not line:
            continue
        ser.write((line + "\n").encode())
        drain(ser, out)
    return 0


def interactive(ser, out):
    fd = sys.stdin.fileno()
    if not os.isatty(fd):
        return batch(ser, out)
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        # GUARDRAIL: tty.setraw() clears OPOST|ONLCR as well as echo/canonical. The ULP sends a bare
        # '\n' (that is what a machine with a 128-byte line buffer should send), so without output
        # post-processing the cursor never returns to column 0 and every reply is indented one more
        # space — the "staircase". Re-enable output mapping only; input stays raw.
        attrs = termios.tcgetattr(fd)
        attrs[1] |= (termios.OPOST | termios.ONLCR)
        termios.tcsetattr(fd, termios.TCSADRAIN, attrs)
        out.write("connected to %s — type Forth, Ctrl-] to quit\n" % ser.portstr)
        out.write("try:  2 3 + .    : SQ DUP * ;    7 SQ .\n\n")
        out.flush()
        while True:
            r, _, _ = select.select([fd, ser.fileno()], [], [], 0.2)
            if ser.fileno() in r:
                chunk = ser.read(256)
                if chunk:
                    out.write(chunk.decode("utf-8", "replace"))
                    out.flush()
            if fd in r:
                data = os.read(fd, 1)
                if not data:
                    return 0
                if data[0] == QUIT:
                    out.write("\n[quit]\n")
                    return 0
                ser.write(data)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def main():
    ap = argparse.ArgumentParser(description="talk to the ULP Forth machine")
    ap.add_argument("--port", default=DEFAULT_PORT)
    ap.add_argument("stdin", nargs="?", help="'-' to send stdin instead of opening a terminal")
    args = ap.parse_args()

    ser = open_port(args.port)
    out = sys.stdout
    try:
        if args.stdin == "-" or not os.isatty(sys.stdin.fileno()):
            return batch(ser, out)
        return interactive(ser, out)
    finally:
        ser.close()


if __name__ == "__main__":
    sys.exit(main())
